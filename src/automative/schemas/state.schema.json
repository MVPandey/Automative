{
  "$defs": {
    "Best": {
      "description": "The incumbent best result.",
      "properties": {
        "commit": {
          "title": "Commit",
          "type": "string"
        },
        "iter": {
          "title": "Iter",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "score",
        "iter",
        "commit"
      ],
      "title": "Best",
      "type": "object"
    },
    "Mode": {
      "description": "What kind of loop the agent is currently driving.",
      "enum": [
        "run",
        "evolve"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Pending": {
      "description": "A ``try`` that committed but has not finished verifying (crash-recovery marker).",
      "properties": {
        "commit": {
          "title": "Commit",
          "type": "string"
        },
        "iter": {
          "title": "Iter",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "iter",
        "commit",
        "started_at"
      ],
      "title": "Pending",
      "type": "object"
    },
    "RunStatus": {
      "description": "Lifecycle of a run.",
      "enum": [
        "active",
        "paused",
        "done"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "Score": {
      "description": "A measured score and the raw samples that produced it.",
      "properties": {
        "samples": {
          "default": [],
          "items": {
            "type": "number"
          },
          "title": "Samples",
          "type": "array"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "score"
      ],
      "title": "Score",
      "type": "object"
    },
    "StopHookState": {
      "description": "Counters the Stop hook uses to detect an agent spinning without iterating.",
      "properties": {
        "blocks_since_last_try": {
          "default": 0,
          "title": "Blocks Since Last Try",
          "type": "integer"
        }
      },
      "title": "StopHookState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything the CLI needs to resume a run from disk.\n\nInvariants: ``iter`` counts completed tries; ``best`` is never worse than ``baseline``; ``pending`` is\nset only between the commit and the decision of a single ``try``.",
  "properties": {
    "base_branch": {
      "title": "Base Branch",
      "type": "string"
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/Score"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "baseline_commit": {
      "title": "Baseline Commit",
      "type": "string"
    },
    "bench_task": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bench Task"
    },
    "best": {
      "anyOf": [
        {
          "$ref": "#/$defs/Best"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "branch": {
      "title": "Branch",
      "type": "string"
    },
    "candidate_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Version"
    },
    "consecutive_errors": {
      "default": 0,
      "title": "Consecutive Errors",
      "type": "integer"
    },
    "denied_tool_calls": {
      "default": 0,
      "title": "Denied Tool Calls",
      "type": "integer"
    },
    "escalated": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Escalated"
    },
    "head": {
      "title": "Head",
      "type": "string"
    },
    "iter": {
      "default": 0,
      "title": "Iter",
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/Mode",
      "default": "run"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "paused_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paused At"
    },
    "paused_total_s": {
      "default": 0.0,
      "title": "Paused Total S",
      "type": "number"
    },
    "pending": {
      "anyOf": [
        {
          "$ref": "#/$defs/Pending"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "protected": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Protected",
      "type": "object"
    },
    "protocol": {
      "title": "Protocol",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "spec_sha": {
      "title": "Spec Sha",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "active"
    },
    "stop_hook": {
      "$ref": "#/$defs/StopHookState"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "tries_since_best": {
      "default": 0,
      "title": "Tries Since Best",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "wall_clock_s": {
      "default": 0.0,
      "title": "Wall Clock S",
      "type": "number"
    }
  },
  "required": [
    "run_id",
    "protocol",
    "branch",
    "base_branch",
    "baseline_commit",
    "head",
    "started_at",
    "updated_at",
    "spec_sha"
  ],
  "title": "RunState",
  "type": "object"
}
